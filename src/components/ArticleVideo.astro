---
import type { Article } from '../lib/writing';
import type { Lang } from '../i18n/ui';
import { formatDateLong } from '../i18n/utils';

interface Props {
  video: NonNullable<Article['data']['video']>;
  title: string;
  lang: Lang;
}
const { video, title, lang } = Astro.props;
const landscape = video.orientation === 'landscape';
const labels = lang === 'sq' ? {
  original: 'Videoja origjinale · TikTok',
  published: 'Publikuar në TikTok',
  retry: 'Ringarko luajtësin',
  loading: 'Duke ngarkuar luajtësin…',
  ready: 'Luajtësi është gati. Shtyp luajtjen për ta parë.',
  unavailable: 'Nëse videoja nuk luhet këtu, ringarko luajtësin ose shikoje në TikTok.',
  external: 'Shiko në TikTok',
  preview: 'Shiko pamjen paraprake',
} : {
  original: 'Original video · TikTok',
  published: 'Published on TikTok',
  retry: 'Reload player',
  loading: 'Loading player…',
  ready: 'Player ready. Press play to watch.',
  unavailable: 'If the video does not play here, reload the player or watch it on TikTok.',
  external: 'Watch on TikTok',
  preview: 'View video preview',
};
const duration = video.seo?.durationSeconds;
const durationLabel = duration ? `${Math.floor(duration / 60)}:${String(duration % 60).padStart(2, '0')}` : undefined;
const playerUrl = `https://www.tiktok.com/player/v1/${video.id}?autoplay=0&controls=1&closed_caption=1&rel=0`;
---

<article-video
  class="article-video"
  data-orientation={video.orientation}
  data-loading={labels.loading}
  data-ready={labels.ready}
  data-unavailable={labels.unavailable}
>
  <figure>
    <p class="article-video-label">{labels.original}</p>
    <div class="article-video-stage">
      <img class="article-video-poster" src={video.poster} alt={video.posterAlt} width={landscape ? 960 : 540} height={landscape ? 540 : 960} decoding="async" />
      <iframe
        src={playerUrl}
        title={`${labels.original}: ${video.seo?.name || title}`}
        width={landscape ? 960 : 540}
        height={landscape ? 540 : 960}
        loading="eager"
        allow="fullscreen"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <figcaption>
      {video.seo?.name && <p class="article-video-name">{video.seo.name}</p>}
      {video.seo?.description && <p class="article-video-description">{video.seo.description}</p>}
      {video.seo && <p class="article-video-meta">
        {labels.published} <time datetime={video.seo.uploadDate}>{formatDateLong(new Date(video.seo.uploadDate), lang)}</time>
        {durationLabel && <> · <time datetime={`PT${duration}S`}>{durationLabel}</time></>}
      </p>}
      <div class="article-video-links">
        <a href={video.url} target="_blank" rel="noopener noreferrer">{labels.external} ↗</a>
        <button type="button" data-video-retry hidden>{labels.retry}</button>
      </div>
      <details class="article-video-preview">
        <summary>{labels.preview}</summary>
        <img src={video.poster} alt={video.posterAlt} width={landscape ? 960 : 540} height={landscape ? 540 : 960} loading="lazy" decoding="async" />
      </details>
      <p class="article-video-status" data-video-status role="status" aria-live="polite"></p>
    </figcaption>
  </figure>
</article-video>

<script>
  class ArticleVideo extends HTMLElement {
    private events?: AbortController;
    private frame?: HTMLIFrameElement;
    private timer?: number;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      this.frame = this.querySelector<HTMLIFrameElement>('iframe') || undefined;
      const retry = this.querySelector<HTMLButtonElement>('[data-video-retry]');
      if (!this.frame || !retry) return;
      retry.hidden = false;
      retry.addEventListener('click', () => {
        if (!this.frame) return;
        this.watchReadiness();
        this.frame.src = this.frame.src;
      }, { signal });
      this.frame.addEventListener('error', () => {
        window.clearTimeout(this.timer);
        this.status(this.dataset.unavailable || '');
      }, { signal });
      window.addEventListener('message', (event: MessageEvent) => {
        if (event.origin !== 'https://www.tiktok.com' || event.source !== this.frame?.contentWindow) return;
        if (event.data?.['x-tiktok-player'] !== true) return;
        if (event.data.type === 'onPlayerReady') {
          window.clearTimeout(this.timer);
          this.status(this.dataset.ready || '');
        } else if (event.data.type === 'onPlayerError' || event.data.type === 'onError') {
          window.clearTimeout(this.timer);
          this.status(this.dataset.unavailable || '');
        }
      }, { signal });
      this.watchReadiness();
    }

    disconnectedCallback() {
      window.clearTimeout(this.timer);
      this.events?.abort();
    }

    private status(message: string) {
      const status = this.querySelector<HTMLElement>('[data-video-status]');
      if (status) status.textContent = message;
    }

    private watchReadiness() {
      window.clearTimeout(this.timer);
      this.status(this.dataset.loading || '');
      // A blocked cross-origin player may send no ready or error message. Keep
      // the actual iframe visible and usable, including if it responds later.
      this.timer = window.setTimeout(() => this.status(this.dataset.unavailable || ''), 20_000);
    }
  }

  if (!customElements.get('article-video')) customElements.define('article-video', ArticleVideo);
</script>
