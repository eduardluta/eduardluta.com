---
import type { Article } from '../lib/writing';
import type { Lang } from '../i18n/ui';

interface Props {
  video: NonNullable<Article['data']['video']>;
  title: string;
  lang: Lang;
}
const { video, title, lang } = Astro.props;
const labels = lang === 'sq' ? {
  original: 'Videoja origjinale · TikTok',
  load: 'Hap videon',
  loading: 'Duke hapur videon…',
  ready: 'Videoja është gati. Shtyp luajtjen për ta parë.',
  unavailable: 'Videoja nuk u hap këtu. Mund ta shohësh në TikTok.',
  external: 'Shiko në TikTok',
  close: 'Mbyll videon',
  note: 'Luajtësi i TikTok ngarkohet vetëm kur hap videon.',
} : {
  original: 'Original video · TikTok',
  load: 'Load video',
  loading: 'Loading video…',
  ready: 'Video ready. Press play to watch.',
  unavailable: 'The video could not load here. You can watch it on TikTok.',
  external: 'Watch on TikTok',
  close: 'Close player',
  note: 'TikTok’s player loads only when you choose to open the video.',
};
---

<article-video
  class="article-video"
  data-video-id={video.id}
  data-video-title={`${labels.original}: ${title}`}
  data-loading={labels.loading}
  data-ready={labels.ready}
  data-unavailable={labels.unavailable}
>
  <figure>
    <p class="article-video-label">{labels.original}</p>
    <div class="article-video-stage">
      <img class="article-video-poster" src={video.poster} alt={video.posterAlt} width="540" height="960" decoding="async" />
      <button class="article-video-load" type="button" data-video-load hidden aria-label={`${labels.load}: ${title}`}>
        <span class="article-video-play" aria-hidden="true">▶</span>
        <span>{labels.load}</span>
      </button>
    </div>
    <figcaption>
      <div class="article-video-links">
        <a href={video.url} target="_blank" rel="noopener noreferrer">{labels.external} ↗</a>
        <button type="button" data-video-close hidden>{labels.close}</button>
      </div>
      <p>{labels.note}</p>
      <p class="article-video-status" data-video-status role="status" aria-live="polite"></p>
    </figcaption>
  </figure>
</article-video>

<script>
  class ArticleVideo extends HTMLElement {
    private events?: AbortController;
    private frame?: HTMLIFrameElement;
    private timer?: number;

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const button = this.querySelector<HTMLButtonElement>('[data-video-load]');
      if (!button) return;
      button.hidden = false;
      button.addEventListener('click', () => this.openPlayer(), { signal });
      this.querySelector('[data-video-close]')?.addEventListener('click', () => this.closePlayer(), { signal });
      window.addEventListener('message', (event: MessageEvent) => {
        if (event.origin !== 'https://www.tiktok.com' || event.source !== this.frame?.contentWindow) return;
        if (event.data?.['x-tiktok-player'] !== true) return;
        if (event.data.type === 'onPlayerReady') {
          const transferFocus = document.activeElement === button;
          window.clearTimeout(this.timer);
          this.dataset.videoReady = 'true';
          this.querySelector('.article-video-stage')?.removeAttribute('aria-busy');
          this.frame?.removeAttribute('aria-hidden');
          this.frame?.removeAttribute('tabindex');
          const close = this.querySelector<HTMLButtonElement>('[data-video-close]');
          if (close) close.hidden = false;
          this.status(this.dataset.ready || '');
          // Keep keyboard focus in the player when its load button disappears.
          if (transferFocus) this.frame?.focus();
        } else if (event.data.type === 'onPlayerError' || event.data.type === 'onError') {
          this.closePlayer(this.dataset.unavailable);
        }
      }, { signal });
    }

    disconnectedCallback() {
      window.clearTimeout(this.timer);
      this.events?.abort();
    }

    private status(message: string) {
      const status = this.querySelector<HTMLElement>('[data-video-status]');
      if (status) status.textContent = message;
    }

    private openPlayer() {
      if (this.frame || !/^\d+$/.test(this.dataset.videoId || '')) return;
      const stage = this.querySelector('.article-video-stage');
      const button = this.querySelector<HTMLButtonElement>('[data-video-load]');
      if (!stage || !button) return;
      button.setAttribute('aria-disabled', 'true');
      stage.setAttribute('aria-busy', 'true');
      this.status(this.dataset.loading || '');
      const frame = document.createElement('iframe');
      frame.src = `https://www.tiktok.com/player/v1/${this.dataset.videoId}?autoplay=0&controls=1&closed_caption=1&rel=0`;
      frame.title = this.dataset.videoTitle || 'TikTok video';
      frame.allow = 'fullscreen';
      frame.allowFullscreen = true;
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.tabIndex = -1;
      frame.setAttribute('aria-hidden', 'true');
      frame.addEventListener('error', () => this.closePlayer(this.dataset.unavailable), { signal: this.events?.signal });
      this.frame = frame;
      stage.append(frame);
      // Cross-origin error pages may emit neither a usable load error nor a ready message.
      this.timer = window.setTimeout(() => this.closePlayer(this.dataset.unavailable), 20_000);
    }

    private closePlayer(message = '') {
      window.clearTimeout(this.timer);
      const shouldFocus = this.contains(document.activeElement);
      this.frame?.remove();
      this.frame = undefined;
      delete this.dataset.videoReady;
      this.querySelector('.article-video-stage')?.removeAttribute('aria-busy');
      const button = this.querySelector<HTMLButtonElement>('[data-video-load]');
      button?.removeAttribute('aria-disabled');
      const close = this.querySelector<HTMLButtonElement>('[data-video-close]');
      if (close) close.hidden = true;
      this.status(message);
      if (shouldFocus) button?.focus();
    }
  }

  if (!customElements.get('article-video')) customElements.define('article-video', ArticleVideo);
</script>
