{
  "name": "binance-square-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "3-day momentum movers on Binance: scan, research, chart screenshots, Square draft. Standalone, not part of the Astro build.",
  "engines": { "node": ">=22" },
  "scripts": {
